<ui:FluentWindow x:Class="PadP2P.App.UpdateNoticeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource UpdateDialog.Title}"
                 Icon="pack://application:,,,/Assets/PadP2P.ico"
                 Width="430" SizeToContent="Height" MinHeight="210" MinWidth="390"
                 ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource UpdateDialog.Title}" FontFamily="Segoe UI Variable Display"
                   FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.78" />
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Margin="0,0,0,9" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{DynamicResource UpdateDialog.Later}" Appearance="Secondary"
                           Click="Later_Click" Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource UpdateDialog.Ignore}" Appearance="Secondary"
                           Click="Ignore_Click" Margin="0,0,8,0" />
                <ui:Button Content="{DynamicResource UpdateDialog.Download}" Appearance="Primary"
                           Click="Download_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
