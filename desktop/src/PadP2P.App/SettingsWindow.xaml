<ui:FluentWindow x:Class="PadP2P.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource Settings.Title}"
                 Icon="pack://application:,,,/Assets/PadP2P.ico"
                 Width="640" Height="720"
                 MinWidth="560" MinHeight="560"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Settings}" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.Description}" Opacity="0.68" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,8" ClipToBounds="True">
            <!-- Fluent uses an overlay scrollbar; this right gutter keeps it clear of text and controls. -->
            <StackPanel Margin="0,0,18,0">
                <Border CornerRadius="10" Padding="14" Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <StackPanel>
                        <ui:ToggleSwitch Content="{DynamicResource Settings.StartWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource Settings.StartWithWindowsHint}" FontSize="11" Opacity="0.65" Margin="0,1,0,14" TextWrapping="Wrap" />
                        <ui:ToggleSwitch Content="{DynamicResource Settings.AutoStartNetwork}" IsChecked="{Binding AutoStartNetwork, Mode=TwoWay}" />
                        <TextBlock Text="{DynamicResource Settings.AutoStartNetworkHint}" FontSize="11" Opacity="0.65" Margin="0,1,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Settings.Language}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag" MinWidth="190">
                        <ComboBoxItem Content="{DynamicResource Language.System}" Tag="System" />
                        <ComboBoxItem Content="{DynamicResource Language.Chinese}" Tag="zh-CN" />
                        <ComboBoxItem Content="{DynamicResource Language.English}" Tag="en-US" />
                    </ComboBox>
                </Grid>

                <Separator Margin="0,20,0,18" />
                <ui:ToggleSwitch Content="{DynamicResource Settings.ShowLaunchers}" IsChecked="{Binding ShowLaunchers, Mode=TwoWay}" />
                <TextBlock Text="{DynamicResource Settings.ShowLaunchersHint}" FontSize="11" Opacity="0.65" Margin="0,1,0,14" TextWrapping="Wrap" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Settings.Launchers}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource Settings.LaunchersHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,2,12,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{DynamicResource Settings.AddLauncher}" Appearance="Secondary"
                               Command="{Binding AddLauncherEntryCommand}" VerticalAlignment="Center" />
                </Grid>

                <ItemsControl ItemsSource="{Binding LauncherEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="12" Margin="0,0,0,9"
                                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             MinHeight="34" Padding="9,4" VerticalContentAlignment="Center"
                                             ToolTip="{DynamicResource Settings.LauncherName}" />
                                    <ui:ToggleSwitch Grid.Column="1" Content="{DynamicResource Settings.LauncherEnabled}"
                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,2">
                                        <TextBlock Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExecutablePath}" Opacity="0.7" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExecutablePath}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Launcher.PathNotSelected}" Opacity="0.55" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExecutablePath}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <ui:Button Content="{DynamicResource Settings.Browse}" Appearance="Secondary"
                                                   Command="{Binding DataContext.SelectLauncherEntryPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" Margin="0,0,8,0" />
                                        <ui:Button Content="{DynamicResource Settings.RemoveLauncher}" Appearance="Secondary"
                                                   Command="{Binding DataContext.RemoveLauncherEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{DynamicResource Settings.SuperDisplayBehaviorHint}"
                                               FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,7,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuperDisplay}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Settings.MultipleLaunchMode}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1" SelectedValue="{Binding MultipleLaunchMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Settings.LaunchModeSelect}" Tag="Select" />
                        <ComboBoxItem Content="{DynamicResource Settings.LaunchModeAll}" Tag="AllEnabled" />
                    </ComboBox>
                </Grid>
                <TextBlock Text="{DynamicResource Settings.LaunchModeHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="130,5,0,0" />

                <Separator Margin="0,20,0,16" />
                <TextBlock Text="{DynamicResource Settings.Updates}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentVersionText" Margin="0,4,0,3" Opacity="0.72" />
                <TextBlock Text="{DynamicResource Settings.UpdatesHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,9" />
                <WrapPanel>
                    <ui:Button x:Name="CheckUpdatesButton" Content="{DynamicResource Settings.CheckUpdates}" Appearance="Secondary"
                               Click="CheckUpdates_Click" Margin="0,0,8,6" />
                    <ui:Button Content="{DynamicResource Settings.OpenReleases}" Appearance="Secondary"
                               Click="OpenReleases_Click" Margin="0,0,8,6" />
                    <ui:Button Content="{DynamicResource Settings.OpenProject}" Appearance="Secondary"
                               Click="OpenProject_Click" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock x:Name="UpdateStatusText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0" />

                <Separator Margin="0,20,0,16" />
                <TextBlock Text="{DynamicResource Settings.SecurityHint}" TextWrapping="Wrap" Opacity="0.65" />
            </StackPanel>
        </ScrollViewer>

        <ui:Button Grid.Row="3" Content="{DynamicResource Settings.Done}" Appearance="Primary" HorizontalAlignment="Right" MinWidth="88"
                   IsDefault="True" Click="Done_Click" Margin="0,14,0,0" />
    </Grid>
</ui:FluentWindow>
