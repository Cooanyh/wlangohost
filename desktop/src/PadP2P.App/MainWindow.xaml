<ui:FluentWindow x:Class="PadP2P.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource AppName}"
                 Icon="pack://application:,,,/Assets/PadP2P.ico"
                 Width="440" Height="638"
                 MinWidth="390" MinHeight="588"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="CanResizeWithGrip"
                 ExtendsContentIntoTitleBar="True"
                 Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="{DynamicResource AppName}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Assets/PadP2P.png'}"
                     ShowMinimize="True" ShowMaximize="True" ShowClose="True" ForceShutdown="False" Height="48" />

        <Grid Grid.Row="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource AppName}" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource AppSubtitle}" Opacity="0.68" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1" Content="{DynamicResource Settings}" Appearance="Secondary" Command="{Binding OpenSettingsCommand}" Margin="12,2,0,0" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <DockPanel>
                    <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding StateText}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.72" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <ui:Button Content="{Binding ActionText}" Command="{Binding ToggleNetworkCommand}"
                           Style="{StaticResource NetworkActionButtonStyle}" Height="48" HorizontalAlignment="Stretch"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ui:Button Command="{Binding OpenLaunchersCommand}" IsEnabled="{Binding CanOpenLaunchers}"
                           ToolTip="{Binding LaunchButtonToolTip}"
                           Appearance="Secondary" Height="48" HorizontalAlignment="Stretch"
                           Visibility="{Binding LaunchButtonVisibility}">
                    <TextBlock Text="{Binding LaunchButtonText}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ui:Button>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource NetworkSettings}" FontSize="11" FontWeight="SemiBold" Opacity="0.62" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Content="{DynamicResource NetworkProfile.Edit}" Appearance="Secondary"
                                   Command="{Binding EditNetworkProfileCommand}" IsEnabled="{Binding CanEditNetworkProfile}"
                                   ToolTip="{DynamicResource NetworkProfile.EditHint}" ToolTipService.ShowOnDisabled="True" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource NetworkName}" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBox Grid.Column="1" Text="{Binding Ssid, Mode=OneWay}" IsReadOnly="True" Padding="9,5" VerticalContentAlignment="Center" />
                        <ui:Button Grid.Column="2" Content="{DynamicResource Copy}" Appearance="Secondary" Command="{Binding CopySsidCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Password}" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBox Grid.Column="1" Text="{Binding DisplayPassphrase, Mode=OneWay}" IsReadOnly="True" Padding="9,5" VerticalContentAlignment="Center" FontFamily="Consolas" />
                        <ui:Button Grid.Column="2" Content="{Binding PasswordVisibilityText}" Appearance="Secondary" Command="{Binding TogglePasswordVisibilityCommand}" Margin="8,0,0,0" />
                        <ui:Button Grid.Column="3" Content="{DynamicResource Copy}" Appearance="Secondary" Command="{Binding CopyPasswordCommand}" Margin="8,0,0,0" />
                    </Grid>

                    <Separator Margin="0,0,0,15" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource ConnectedDevices}" FontSize="11" FontWeight="SemiBold" Opacity="0.62" />
                        <TextBlock Grid.Column="1" Text="{Binding DeviceCountText}" HorizontalAlignment="Right" Opacity="0.72" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ConnectedDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Ellipse Width="6" Height="6" Fill="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.StateBrush}" VerticalAlignment="Center" Margin="1,0,9,0" />
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource DevicePlaceholder}" Opacity="0.62" TextWrapping="Wrap" Margin="0,5,0,0"
                               Visibility="{Binding DevicePlaceholderVisibility}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{Binding StateBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Text="{DynamicResource TrayFooter}" FontSize="11" Opacity="0.62" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</ui:FluentWindow>
