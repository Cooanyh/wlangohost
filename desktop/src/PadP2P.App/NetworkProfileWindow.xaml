<ui:FluentWindow x:Class="PadP2P.App.NetworkProfileWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource NetworkProfile.Title}"
                 Icon="pack://application:,,,/Assets/PadP2P.ico"
                 Width="460" Height="390"
                 MinWidth="420" MinHeight="370"
                 ResizeMode="CanResizeWithGrip"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource NetworkProfile.Title}" FontFamily="Segoe UI Variable Display" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource NetworkProfile.Description}" Opacity="0.68" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource NetworkName}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="SsidTextBox" MaxLength="32" Padding="10,6" VerticalContentAlignment="Center" />
            <TextBlock Text="{DynamicResource NetworkProfile.SsidHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Password}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="PassphraseBox" MaxLength="63" Padding="10,6" />
            <TextBlock Text="{DynamicResource NetworkProfile.PasswordHint}" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <TextBlock x:Name="ValidationMessage" Grid.Row="3" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,0,12" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{DynamicResource NetworkProfile.Cancel}" Appearance="Secondary" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Content="{DynamicResource NetworkProfile.Save}" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
